# ============================================
# MOLEMISI ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ============================================
# API (NestJS)
# ============================================
# NOTE: do NOT set NODE_ENV here. Next.js and NestJS set it themselves
# (next build forces production; next dev / pnpm dev set development).
# A stray NODE_ENV=development in .env breaks `next build` with a cryptic
# "Cannot read properties of null (reading 'useContext')" prerender error.
PORT=3001
API_URL=http://localhost:3001

# ============================================
# WEB (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# GAME (Phaser)
# ============================================
VITE_API_URL=http://localhost:3001/api/v1

# ============================================
# PIXELLAB ASSET GENERATION (Optional)
# ============================================
# Token from https://pixellab.ai/account — used only by
# scripts/generate-pixellab-assets.mjs (never exposed to the browser).
PIXELLAB_API_KEY=

# ============================================
# SECURITY
# ============================================
JWT_SECRET=change-this-in-production
CORS_ORIGIN=http://localhost:3000

# ============================================
# PAYMENTS (Optional - Phase 7)
# ============================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ORANGE_MONEY_API_KEY=...
