{
  "name": "molemisi",
  "version": "0.1.0",
  "private": true,
  "description": "Molemisi - Pixel-art farm management simulator",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration:new": "supabase migration new",
    "db:seed": "pnpm --filter @molemisi/api db:seed",
    "dev:kill": "node scripts/kill-dev.mjs",
    "assets:generate": "node scripts/generate-pixellab-assets.mjs && pnpm assets:sync && node scripts/generate-icons.mjs && node scripts/generate-media-assets.mjs",
    "assets:dry-run": "node scripts/generate-pixellab-assets.mjs --dry-run",
    "assets:sync": "node scripts/sync-assets.mjs",
    "font:build": "node scripts/build-font.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "media:generate": "node scripts/generate-media-assets.mjs",
    "predev": "node scripts/build-font.mjs && pnpm assets:sync && node scripts/generate-icons.mjs",
    "prebuild": "node scripts/build-font.mjs && pnpm assets:sync && node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
